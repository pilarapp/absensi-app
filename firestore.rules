rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.isSuperAdmin == true || 
        request.auth.token.email == 'pilarss@admin.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function isEmployee(employeeId) {
      return isAuthenticated() && request.auth.uid == employeeId;
    }

    // 1. Koleksi Admins: Hanya dapat dibaca oleh Admin & Super Admin, hanya Super Admin yang bisa menulis
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // 2. Koleksi Employees: Admin memiliki akses penuh, karyawan hanya bisa memperbarui data profil non-sensitif miliknya sendiri
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isEmployee(employeeId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gajiPokok', 'status', 'shiftMasuk', 'shiftKeluar', 'posisi', 'lokasiId', 'bpjsTk', 'bpjsKes'])
      );
    }

    // 3. Koleksi Absensi: Karyawan hanya dapat membaca data absensinya sendiri, Admin mengelola semua
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.karyawanId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.karyawanId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.karyawanId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jamKeluar', 'koordinatKeluar', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // 4. Koleksi Pengajuan Izin/Cuti: Karyawan hanya dapat membaca pengajuannya sendiri & mengedit saat status Menunggu atau Revisi
    match /requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.karyawanId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.karyawanId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isAuthenticated() && resource.data.karyawanId == request.auth.uid && (resource.data.status == 'Menunggu' || resource.data.status == 'Revisi'));
      allow delete: if isAdmin();
    }

    // 5. Koleksi Slip Gaji: Sangat rahasia, hanya admin dan karyawan pemilik slip yang bisa membaca
    match /salary_slips/{slipId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.karyawanId == request.auth.uid);
      allow write: if isAdmin();
    }

    // 6. Koleksi Keuangan Perusahaan: Khusus Admin/Keuangan
    match /finances/{financeId} {
      allow read, write: if isAdmin();
    }

    // 7. Koleksi Lokasi Kantor: Karyawan membaca untuk validasi radius, Admin mengelola
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 8. Koleksi Master Posisi/Jabatan
    match /positions/{positionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 9. Koleksi Notifikasi: Dibaca dan diperbarui hanya oleh penerima notifikasi atau Admin
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 10. Koleksi Audit Logs: Bersifat IMMUTABLE (dibuat oleh admin, dibaca KHUSUS oleh Super Admin)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 11. Koleksi Surat Peringatan (SP): Dikelola oleh Admin, dibaca oleh karyawan bersangkutan & Admin
    match /surat_peringatan/{spId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.karyawanId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.karyawanId == request.auth.uid);
    }

    // 12. Koleksi Settings (Pengaturan Perusahaan): Dibaca oleh semua karyawan, diubah hanya oleh admin
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
